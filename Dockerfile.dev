FROM php:8.3-cli

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        unzip \
        git \
        libzip-dev \
        libonig-dev \
    && docker-php-ext-install \
        pdo_mysql \
        zip \
        pcntl \
        mbstring \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── Composer ──────────────────────────────────────────────────────────────────
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# ── Dependencies (layer-cached separately from source) ────────────────────────
COPY composer.json composer.lock ./
RUN composer install --no-interaction --no-scripts --prefer-dist

# ── Application source ────────────────────────────────────────────────────────
COPY . .
RUN composer run-script post-autoload-dump || true

# storage/ and bootstrap/cache must be writable by the process user.
# In dev we run as root so this is informational; the prod image fixes it.
RUN chmod -R 775 storage bootstrap/cache

EXPOSE 8000

# artisan serve for the dev loop — hot reload by mounting the source volume.
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
