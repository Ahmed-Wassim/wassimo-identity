FROM dunglas/frankenphp:1-php8.3

# ── System dependencies ───────────────────────────────────────────────────────
# FrankenPHP images ship install-php-extensions (no pecl dance needed).
RUN install-php-extensions \
        pdo_mysql \
        zip \
        pcntl \
        mbstring \
        redis \
        opcache

# ── Composer ──────────────────────────────────────────────────────────────────
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# ── Dependencies (layer-cached separately from source) ────────────────────────
COPY composer.json composer.lock ./
RUN composer install --no-interaction --no-scripts --prefer-dist

# ── Application source ────────────────────────────────────────────────────────
# Volume-mounted at runtime (compose), so COPY here only seeds the image.
COPY . .
RUN composer run-script post-autoload-dump || true

RUN chmod -R 775 storage bootstrap/cache

# PHP caches for the worker. FrankenPHP keeps ONE booted app in memory, so
# per-request boot cost disappears structurally (the artisan-serve problem this
# replaces). SHM works here (real SAPI, unlike php -S quirks), so no file
# cache games: plain opcache + timestamp validation for hot reload.
RUN printf '%s\n' \
        'opcache.enable=1' \
        'opcache.enable_cli=1' \
        'opcache.validate_timestamps=1' \
        'opcache.revalidate_freq=0' \
        'realpath_cache_size=4096K' \
        'realpath_cache_ttl=600' \
    > /usr/local/etc/php/conf.d/php-dev.ini

EXPOSE 8000

# Octane + FrankenPHP worker. --watch restarts workers on file change (dev
# hot-reload); --max-requests recycles each worker (memory-leak safety).
# NOTE: no `serve --no-reload` env-stripping issue here — Octane runs in the
# artisan process itself, so compose environment reaches workers directly.
CMD ["php", "artisan", "octane:start", "--server=frankenphp", \
     "--host=0.0.0.0", "--port=8000", "--watch", "--max-requests=500"]
